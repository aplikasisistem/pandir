# ==============================================================================
# PANDIRSTORE.ID - ENVIRONMENT VARIABLES CONFIGURATION GUIDE
# ==============================================================================
#
# SKENARIO 1 (DIREKOMENDASIKAN): FULL SERVERLESS DI NETLIFY (TANPA BACKEND TERPISAH)
# Aplikasi berjalan 100% di Netlify menggunakan Netlify Serverless Functions (netlify/functions/auth.ts).
# Anda TIDAK PERLU menyewa/menjalankan server Express di Render atau Railway!
#
# Di Netlify Dashboard (Site configuration -> Environment variables), masukkan:
#
# 1. Kredensial Admin Seller (Wajib diisi jika ingin custom password):
ADMIN_USERNAME="Pandir"
ADMIN_PASSWORD="Pamarayan123@"
ADMIN_JWT_SECRET="pandirstore_secure_jwt_secret_key_prod_v2_2026"

# 2. Base URL Backend API:
#    PENTING: KOSONGKAN ATAU JANGAN BUAT variabel VITE_API_URL di Netlify jika ingin
#    menggunakan Netlify Functions bawaan. Aplikasi otomatis memakai same-origin (/api/auth/login).
# VITE_API_URL=""

# 3. Konfigurasi Firebase Firestore (Opsional di Netlify):
#    Aplikasi sudah memiliki konfigurasi default dari firebase-applet-config.json.
#    Hanya isi jika Anda ingin mengarahkan ke Firebase project pribadi Anda:
VITE_FIREBASE_API_KEY="AIzaSyCDPwxQRLEG0XYuTs0rlbN-GG6MOjAAh3c"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0957756333.firebaseapp.com"
